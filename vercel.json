{
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/docs",
      "destination": "/api/index.py"
    },
    {
      "source": "/openapi.json",
      "destination": "/api/index.py"
    },
    {
      "source": "/login",
      "destination": "/frontend/login.html"
    },
    {
      "source": "/signup",
      "destination": "/frontend/signup.html"
    },
    {
      "source": "/my-requests",
      "destination": "/frontend/my-requests.html"
    },
    {
      "source": "/technical-documents",
      "destination": "/frontend/technical-documents.html"
    },
    {
      "source": "/documents",
      "destination": "/frontend/documents.html"
    },
    {
      "source": "/services/:slug",
      "destination": "/frontend/services/:slug/index.html"
    },
    {
      "source": "/services/:slug/",
      "destination": "/frontend/services/:slug/index.html"
    },
    {
      "source": "/services/:slug/:file*",
      "destination": "/frontend/services/:slug/:file*"
    },
    {
      "source": "/",
      "destination": "/frontend/index.html"
    },
    {
      "source": "/:path*",
      "destination": "/frontend/:path*"
    }
  ]
}
